# ---------------------------------------------------------------------------
# Deployment. Every variable below is read by a script in script/; none has a
# default, so a missing one fails the run rather than deploying something
# unintended.
#
# DEPLOYER_PRIVATE_KEY is a raw key, which is acceptable for a testnet holding
# mock tokens and is NOT acceptable for mainnet. Before any mainnet deploy,
# import a keystore (`cast wallet import`) or use a hardware signer and pass
# --account / --ledger instead of reading a key from the environment.
# ---------------------------------------------------------------------------

# Guards every deploy and init script. Must equal the chain id behind --rpc-url
# or the script reverts before broadcasting. 1 = mainnet, 11155111 = sepolia.
EXPECTED_CHAIN_ID=

# The Uniswap v4 PoolManager on the target chain. Checked for code before use.
POOL_MANAGER=

DEPLOYER_PRIVATE_KEY=

# --- InitializePool only ---------------------------------------------------
VANE_HOOK=
TOKEN0=
TOKEN1=
POOL_FEE=
TICK_SPACING=
SQRT_PRICE_X96=

# Wei of currency1 per flow unit. Sets where the flow-variance accumulator
# saturates: net per-block flow above 2^32 * FLOW_UNIT wei overflows the
# estimator and holds the gain at zero until the pool is re-allowlisted with a
# larger value. Valid range is 1e9 to 1e18. Size it to the pool: at 1e12 the
# ceiling is roughly 4,294 ether of net per-block flow, which a deep pool
# exceeds routinely.
FLOW_UNIT=

# --- Replay simulator (sim/) ----------------------------------------------
# All optional; the defaults in test/sim/SimStateDump.t.sol are used when unset.
# These shape the dumped pool, so changing one requires re-running the dump.
SIM_LIQUIDITY=
SIM_RESERVE=
SIM_RANGE=
SIM_FEE=
SIM_SPACING=
SIM_FLOW_UNIT=
