# RPC endpoint for fork tests and deployment.
RPC_URL=

# Deployer key. The address derived from it becomes the hook OWNER, which is the only
# account able to allowlist pools and set reserve targets. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# The v4 PoolManager on the target chain.
POOL_MANAGER=

# Set after running DeployVane, consumed by InitializePool.
VANE_HOOK=

# Pool to attach to. TOKEN0 must sort strictly below TOKEN1, or the pool id refers to a
# pool nobody intended.
TOKEN0=
TOKEN1=
POOL_FEE=3000
TICK_SPACING=60
SQRT_PRICE_X96=

# Optional, for contract verification.
ETHERSCAN_API_KEY=
